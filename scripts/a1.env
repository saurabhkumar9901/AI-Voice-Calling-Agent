###############################################################################
### Oracle Cloud Always Free — Ampere A1 target configuration
###
### Sourced by scripts/hunt-a1.sh. Kept in sync by hand with the defaults in
### scripts/variables.tf — if you change a value here, change it there too.
###
### Everything in this file is non-secret. Never add an OCI API private key,
### a tenancy secret or a password. The API key lives in GitHub Actions
### secrets (OCI_CLI_KEY_CONTENT_B64) and nowhere else.
###############################################################################

REGION="ap-mumbai-1"

# ap-mumbai-1 has exactly one availability domain, so there is nothing to
# rotate. The "try AD-1/2/3" trick from the blog posts does not apply here.
AVAILABILITY_DOMAIN="TlIq:AP-MUMBAI-1-AD-1"

COMPARTMENT_ID="ocid1.tenancy.oc1..aaaaaaaahwx5lp55gpy7votjzmoa5pfoyqjxcqf4sxpqr4yjxkdzxropm5ta"

# Ubuntu aarch64 image. If the launch starts failing with InvalidParameter
# instead of OutOfHostCapacity, this image has probably been deprecated —
# refresh it with:
#   oci compute image list --compartment-id <tenancy> --operating-system "Canonical Ubuntu" \
#     --shape VM.Standard.A1.Flex --sort-by TIMECREATED --query 'data[0].id' --raw-output
IMAGE_ID="ocid1.image.oc1.ap-mumbai-1.aaaaaaaa2jurqb3jm7hlpqw3au35loaqjkcozbyh7znn4jnfu5zbrgfulwia"

SUBNET_ID="ocid1.subnet.oc1.ap-mumbai-1.aaaaaaaagzdxqmrcfk65wmhg74grgcgl4zu2cljuxfdjeqkdv4qpkh6qdwsq"

NSG_IDS=(
  "ocid1.networksecuritygroup.oc1.ap-mumbai-1.aaaaaaaa47jkrq42cckcxxymjrmox4ajl6z3k4jz3ygjkstti26fi5onnfba"
)

DISPLAY_NAME="dograh-a1"

# Always Free A1 is currently 2 OCPU / 12 GB (1,500 OCPU-hours + 9,000 GB-hours
# per month, divided by ~730 hours). Asking for 4 OCPU / 24 GB is 2x the free
# allowance: it will either fail on the tenancy limit or start billing you.
# 2/12 is also a smaller capacity ask, so it is far easier to win.
OCPUS=2
MEMORY_GBS=12

BOOT_VOLUME_GBS=150

# Optional cloud-init applied at first boot. Relative to the repo root.
# guides/oci/cloud-init.sh installs Docker + Compose, adds swap and opens the
# firewall ports. Set to "" to launch a bare instance.
USER_DATA_FILE="guides/oci/cloud-init.sh"

SSH_PUBLIC_KEY="ssh-rsa  ssh-key-2026-10-28"
