map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name __DOMAIN__;

    # Let's Encrypt HTTP-01 challenge (served from the certbot webroot).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name __DOMAIN__;

    ssl_certificate     /etc/nginx/certs/local.crt;
    ssl_certificate_key /etc/nginx/certs/local.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Enable once you are sure every subdomain is HTTPS-only.
    # add_header Strict-Transport-Security "max-age=31536000" always;

    # Document/audio uploads.
    client_max_body_size 100M;

    # Audio recordings and uploaded documents. The app hands out *unsigned*
    # URLs (anonymous bucket policy), so this route must proxy PUT as well as
    # GET. Anyone who learns the bucket path can therefore write to it — keep
    # an eye on disk usage and put WAF/rate limiting in front for public use.
    location /voice-audio/ {
        proxy_pass http://minio:9000/voice-audio/;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        proxy_pass http://ui:3010;
        proxy_http_version 1.1;

        # WebSockets (call signaling, live transcripts).
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # Calls can stay open for a long time.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_connect_timeout 60s;

        # sub_filter cannot rewrite gzip/brotli bodies, and Next.js compresses
        # by default. Ask upstream for identity encoding so the rewrite below
        # actually applies.
        proxy_set_header Accept-Encoding "";

        # Rewrite internal MinIO URLs in API responses to the public domain.
        sub_filter 'http://localhost:9000/voice-audio/' 'https://$host/voice-audio/';
        sub_filter_once off;
        sub_filter_types application/json text/html;
    }
}
